[sqlfluff]
dialect = bigquery
templater = raw
max_line_length = 120
# LT01/LT02 (spacing/indentation) are excluded deliberately, not for
# convenience: the DDL aligns types in columns and the analysis queries are
# hand-formatted to be read. `sqlfluff fix` flattens both and makes the file
# worse to read, which in a repo meant to be read is the opposite of the
# point. Every rule of substance stays active — and is BLOCKING in CI:
# ambiguous joins, unqualified references, aliasing, dialect.
exclude_rules = LT05, LT01, LT02, ST06, RF04, AM04

[sqlfluff:indentation]
indented_joins = false
indented_using_on = true

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.identifiers]
extended_capitalisation_policy = lower
